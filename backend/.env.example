# Database
DATABASE_URL=sqlite:///./document_intelligence.db

# LLM API (choose one provider)
# Option 1: OpenAI (requires API key)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4-turbo-preview

# Option 2: Ollama (FREE - local LLM, requires Ollama installation)
# Install Ollama from https://ollama.ai then run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Choose which LLM provider to use: "openai" or "ollama"
LLM_PROVIDER=ollama

# OCR Configuration
TESSERACT_CMD=tesseract
TESSERACT_PATH=/usr/bin/tesseract

# Server Configuration
HOST=0.0.0.0
PORT=8000
